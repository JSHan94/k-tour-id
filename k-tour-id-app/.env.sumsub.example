# Sandbox PREVIEW only. Copy to .env.local (gitignored); never commit values.
NEXT_PUBLIC_ONDO_SUMSUB_SANDBOX=1
SUMSUB_MODE=sandbox
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=id-and-liveness
# Independently generated random values, not the provider secret.
SUMSUB_SESSION_SECRET=
SUMSUB_PREVIEW_ACCESS_CODE=
# Exact origins only. Vercel also binds to its current VERCEL_URL in Preview.
SUMSUB_ALLOWED_ORIGINS=http://localhost:3094
